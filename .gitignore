# Python bytecode & cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Test coverage
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Relational data, state, and logs
data/
*.sqlite
*.log

# IDE & OS Specific junk
# .vscode/ is ignored except the pinned config files we want in the repo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store

# Environments
.env
.env.*
!.env.example

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Database dumps
*.dump

# Local Docker Compose overrides
deployments/*/docker-compose.override.yml
