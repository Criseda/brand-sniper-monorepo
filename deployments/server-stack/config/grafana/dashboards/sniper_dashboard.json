{
  "uid": "79c80f9c-f2f0-40bd-8eb8-301f8e7ab1f4",
  "version": 5,
  "title": "Brand Sniper Live Dashboard",
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["sniper", "csgo", "market"],
  "panels": [
    {
      "type": "row",
      "title": "Trading Summary",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Total Simulated Profit & Loss (PnL)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        { "expr": "paper_trading_estimated_profit_total / 100", "legendFormat": "USD", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 0 }
          ]}
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "type": "stat",
      "title": "Total Trades Executed",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        { "expr": "paper_trades_executed_total", "legendFormat": "Trades", "refId": "A" }
      ],
      "options": { "colorMode": "none", "graphMode": "area" }
    },
    {
      "type": "timeseries",
      "title": "Simulated Trades/min",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        { "expr": "rate(paper_trades_executed_total[5m]) * 60", "legendFormat": "Simulated Trades", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "suffix: trades/min" } }
    },
    {
      "type": "timeseries",
      "title": "Simulated PnL/min",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        { "expr": "rate(paper_trading_estimated_profit_total[5m]) * 60 / 100", "legendFormat": "PnL / min", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "type": "row",
      "title": "Ingestion Pipeline",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Ticks Processed/sec",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum by (listener) (rate(listener_ticks_processed_total[1m]))", "legendFormat": "{{listener}} processed", "refId": "A" },
        { "expr": "sum by (listener) (rate(listener_ticks_deduplicated_total[1m]))", "legendFormat": "{{listener}} deduplicated", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "suffix: ticks/s" } },
      "stack": { "mode": "normal" }
    },
    {
      "type": "gauge",
      "title": "Deduplication Cache Size",
      "description": "Items in each venue's dedup cache against the default cap of 100,000 (DEDUP_CACHE_MAX_SIZE). Orange from 80% and red from 95% of the cap; if the cap is changed, change this max too.",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 6 },
      "targets": [
        { "expr": "listener_dedup_cache_size{venue!=\"\"}", "legendFormat": "{{listener}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 100000,
          "thresholds": { "mode": "percentage", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 80 },
            { "color": "red", "value": 95 }
          ]}
        }
      },
      "options": { "orientation": "horizontal" }
    },
    {
      "type": "gauge",
      "title": "Batch Buffer Size",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 6 },
      "targets": [
        { "expr": "listener_batch_buffer_size", "legendFormat": "{{listener}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": { "mode": "percentage", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 80 },
            { "color": "red", "value": 95 }
          ]}
        }
      },
      "options": { "orientation": "horizontal" }
    },
    {
      "type": "timeseries",
      "title": "Batch Flushes/min",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 6 },
      "targets": [
        { "expr": "sum by (listener) (rate(listener_batch_flush_total{status=\"success\"}[5m])) * 60", "legendFormat": "{{listener}} success", "refId": "A" },
        { "expr": "sum by (listener) (rate(listener_batch_flush_total{status=\"retry\"}[5m])) * 60", "legendFormat": "{{listener}} retry", "refId": "B" },
        { "expr": "sum by (listener) (rate(listener_batch_flush_total{status=\"dead_letter\"}[5m])) * 60", "legendFormat": "{{listener}} dead letter", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "suffix: flushes/min" } }
    },
    {
      "type": "row",
      "title": "Anomaly Detection & Rules Engine (DRE)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Potential Anomalies Flagged/min",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum by (listener) (rate(listener_anomalies_detected_total{source=\"local\"}[1m])) * 60", "legendFormat": "{{listener}} local", "refId": "A" },
        { "expr": "sum by (listener) (rate(listener_anomalies_detected_total{source=\"hybrid\"}[1m])) * 60", "legendFormat": "{{listener}} hybrid", "refId": "B" },
        { "expr": "sum by (listener) (rate(listener_anomalies_detected_total{source=\"macro\"}[1m])) * 60", "legendFormat": "{{listener}} macro", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "suffix: detections/min" } },
      "stack": { "mode": "normal" }
    },
    {
      "type": "timeseries",
      "title": "DRE Decisions/min",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 12 },
      "targets": [
        { "expr": "sum by (listener) (rate(listener_anomalies_confirmed_total[1m])) * 60", "legendFormat": "{{listener}} confirmed by DRE", "refId": "A" },
        { "expr": "sum by (listener) (rate(listener_anomalies_rejected_total[1m])) * 60", "legendFormat": "{{listener}} filtered/rejected", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "suffix: outcomes/min" } }
    },
    {
      "type": "bargauge",
      "title": "DRE Approvals by Rule and Source (selected range)",
      "description": "How many listings the DRE approved in the selected time range. Each bar is one combination of: the DRE rule that approved it, the Z-score source that flagged it (local window, hybrid, or macro baseline), and where the price came from (rest_snapshot is a REST lowest ask, listing is a live feed listing). It counts decisions, not profit.",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "expr": "round(sum by (listener, reason, source, tick_kind) (increase(listener_anomalies_confirmed_total{reason!=\"\"}[$__range]))) > 0",
          "instant": true,
          "legendFormat": "{{listener}}: {{reason}} rule, {{source}} Z-score, {{tick_kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "noValue": "No approvals in this range"
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "row",
      "title": "Performance & Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "DRE Latency (ms)",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 18 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(listener_rules_engine_latency_seconds_bucket[1m])) by (le, listener)) * 1000", "legendFormat": "{{listener}} p50 (ms)", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(listener_rules_engine_latency_seconds_bucket[1m])) by (le, listener)) * 1000", "legendFormat": "{{listener}} p95 (ms)", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(listener_rules_engine_latency_seconds_bucket[1m])) by (le, listener)) * 1000", "legendFormat": "{{listener}} p99 (ms)", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "type": "timeseries",
      "title": "Redis Latency (ms)",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 18 },
      "targets": [
        { "expr": "sum by (listener) (rate(listener_redis_operation_latency_seconds_sum[1m])) / sum by (listener) (rate(listener_redis_operation_latency_seconds_count[1m])) * 1000", "legendFormat": "{{listener}} avg (ms)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "type": "row",
      "title": "System Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "type": "gauge",
      "title": "Redis Memory",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 24 },
      "targets": [
        { "expr": "redis_memory_used_bytes", "legendFormat": "Used", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "mode": "percentage", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 80 },
            { "color": "red", "value": 95 }
          ]}
        }
      }
    },
    {
      "type": "stat",
      "title": "Redis Keys",
      "gridPos": { "h": 5, "w": 4, "x": 6, "y": 24 },
      "targets": [
        { "expr": "redis_db_keys{db=\"db0\"}", "legendFormat": "Keys", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" } },
      "options": { "colorMode": "none", "graphMode": "area" }
    },
    {
      "type": "timeseries",
      "title": "Backend Errors/min",
      "gridPos": { "h": 5, "w": 7, "x": 10, "y": 24 },
      "targets": [
        { "expr": "sum by (status_code) (rate(backend_http_errors_total[5m])) * 60", "legendFormat": "HTTP {{status_code}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "suffix: errors/min" } }
    },
    {
      "type": "stat",
      "title": "Services Status",
      "gridPos": { "h": 5, "w": 7, "x": 17, "y": 24 },
      "targets": [
        { "expr": "up{job=\"sniper-backend\"}", "legendFormat": "Backend", "refId": "A" },
        { "expr": "up{job=\"sniper-listener\"}", "legendFormat": "Listener {{listener}}", "refId": "B" },
        { "expr": "up{job=\"sniper-redis\"}", "legendFormat": "Redis", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "options": { "colorMode": "value", "graphMode": "none" }
    },
    {
      "type": "row",
      "title": "Bounded Work Supervision",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Background Queue Depth",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 30 },
      "targets": [
        { "expr": "listener_background_jobs_queued", "legendFormat": "{{listener}} {{job_type}}", "refId": "A" },
        { "expr": "listener_tick_queue_size", "legendFormat": "{{listener}} ticks", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 } }
    },
    {
      "type": "timeseries",
      "title": "Background Job Outcomes/min",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 30 },
      "targets": [
        { "expr": "sum by (listener, job_type, outcome) (rate(listener_background_jobs_total[5m])) * 60", "legendFormat": "{{listener}} {{job_type}} {{outcome}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "suffix: jobs/min" } }
    },
    {
      "type": "timeseries",
      "title": "Trade Submission Outcomes/min",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 30 },
      "targets": [
        { "expr": "sum by (listener, outcome) (rate(listener_trade_submissions_total[5m])) * 60", "legendFormat": "{{listener}} {{outcome}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "suffix: submissions/min" } }
    },
    {
      "type": "row",
      "title": "Live Feeds (Waxpeer)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Feed Events/min by Filter Outcome",
      "description": "Live feed events per minute by what the recording filter did with them. Only 'recorded' reaches the database (docs/waxpeer_feed.md).",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 36 },
      "targets": [
        { "expr": "sum by (listener, event, outcome) (rate(listener_feed_events_filtered_total[5m])) * 60", "legendFormat": "{{listener}} {{event}} {{outcome}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "suffix: events/min", "min": 0 } }
    },
    {
      "type": "stat",
      "title": "Feed State",
      "description": "Connected is 1 while the feed is subscribed. Resale prices is how many Skinport prices the filter holds; at 0 it records nothing.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 36 },
      "targets": [
        { "expr": "listener_feed_connected", "legendFormat": "{{listener}} connected", "refId": "A" },
        { "expr": "listener_feed_resale_prices", "legendFormat": "{{listener}} resale prices", "refId": "B" },
        { "expr": "listener_feed_tracked_listings", "legendFormat": "{{listener}} tracked listings", "refId": "C" }
      ],
      "options": { "colorMode": "value", "graphMode": "none" }
    }
  ]
}
