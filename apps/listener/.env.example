# Listener Microservice - App-specific overrides
# Shared vars (DATABASE_URL, etc.) come from root .env
# Copy this file to '.env'

# 1. Skinport API Credentials (not used yet: /v1/items is called without them, #275)
SKINPORT_CLIENT_ID="your_client_id_here"
SKINPORT_CLIENT_SECRET="your_client_secret_here"

# 1b. Waxpeer API key (read only use: live listing feed and price snapshots, #261)
# Get it at https://waxpeer.com/profile/user. The key can also buy items and transfer
# money, so keep the Waxpeer balance at zero on the account it belongs to.
WAXPEER_API_KEY="your_key_here"

# 1c. DMarket Trading API keys (read only use: listings, #339). Generate them under Trading
# API in the DMarket account settings. The baseline builder uses the same pair (apps/analytics/.env).
DMARKET_PUBLIC_KEY="your_public_key_here"
DMARKET_SECRET_KEY="your_secret_key_here"

# 2. Network Targets
COMPUTE_NODE_IP="localhost"
LISTENER_HEALTH_PORT="9101"

# 3. Cloudflare cookie for the Skinport sale feed (optional: the feed connects without it today).
# If Cloudflare starts challenging the connection, copy cf_clearance from a browser session on skinport.com.
CLOUDFLARE_COOKIE="your_cf_clearance_cookie_here"

# 4. Redis Hot Cache (Edge Node local Redis, port 6380 — matches edge-stack docker-compose)
EDGE_REDIS_URL="redis://localhost:6380"

# 5. Bounded Work Queues
LISTENER_TICK_QUEUE_SIZE="10000"
LISTENER_ANOMALY_WORKERS="4"
LISTENER_ANOMALY_QUEUE_SIZE="128"
LISTENER_BATCH_WORKERS="2"
LISTENER_BATCH_QUEUE_SIZE="8"
LISTENER_BATCH_MAX_ATTEMPTS="5"
LISTENER_BATCH_RETRY_BASE_SECONDS="0.5"
LISTENER_BATCH_RETRY_MAX_SECONDS="8"
LISTENER_SHUTDOWN_GRACE_SECONDS="30"

# 6. Trade Alerts (#18). A channel is on when its credentials are set; leave them empty to send nothing.
# Discord: Server Settings > Integrations > Webhooks > New Webhook, then Copy Webhook URL.
DISCORD_WEBHOOK_URL=""
# Telegram: create a bot with @BotFather for the token, add it to the chat, and use the chat's ID.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Set to "false" to turn a channel off without removing its credentials.
DISCORD_ALERTS_ENABLED="true"
TELEGRAM_ALERTS_ENABLED="true"
# Per channel: messages a minute, queued alerts before new ones are dropped, the longest wait for the
# channel (rate limit or a provider's 429) before giving up, and requests per alert when 429s repeat.
ALERT_MAX_PER_MINUTE="20"
ALERT_QUEUE_SIZE="32"
ALERT_MAX_WAIT_SECONDS="60"
ALERT_MAX_ATTEMPTS="3"
