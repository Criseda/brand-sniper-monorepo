# Analytics Microservice - App-specific overrides
# Shared vars (DATABASE_URL, etc.) come from root .env
# Copy this file to '.env'

# 1. Orchestration & Tracking
PREFECT_API_URL="http://localhost:4200/api"
MLFLOW_TRACKING_URI="http://localhost:5000"

# 1b. DMarket Trading API keys (read only use: sales history and fees for the DMarket
# baselines, #339). Generate them under Trading API in the DMarket account settings.
# The secret key is 64 bytes of hex. The listener uses the same pair (apps/listener/.env).
DMARKET_PUBLIC_KEY="your_public_key_here"
DMARKET_SECRET_KEY="your_secret_key_here"

# 2. CFO LLM overrides (optional — root .env provides LLM_BASE_URL,
# LLM_MODEL, LLM_API_KEY, LLM_FALLBACK_MODELS, LLM_REQUEST_TIMEOUT_SECONDS,
# LLM_MAX_TOKENS, LLM_REASONING_EFFORT).
# Uncomment to point analytics at a different OpenAI-compatible endpoint:
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_MODEL="mistral-7b"
# LLM_ALLOW_NO_AUTH="true"
