# Analytics Microservice - App-specific overrides
# Shared vars (DATABASE_URL, etc.) come from root .env
# Copy this file to '.env'

# 1. Orchestration & Tracking
PREFECT_API_URL="http://localhost:4200/api"
MLFLOW_TRACKING_URI="http://localhost:5000"

# 2. CFO LLM overrides (optional — root .env provides LLM_BASE_URL,
# LLM_MODEL, LLM_API_KEY, LLM_FALLBACK_MODELS, LLM_REQUEST_TIMEOUT_SECONDS).
# Uncomment to point analytics at a different OpenAI-compatible endpoint:
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_MODEL="mistral-7b"
# LLM_ALLOW_NO_AUTH="true"
